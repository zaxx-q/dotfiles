#!/usr/bin/env bash
# Helper script to manage the project itself.

set -o errexit
set -o pipefail

lint() {
  # Lint all supported file types
  local shellcheck_cmd=(shellcheck)
  local ruff_cmd=(ruff)

  if ! command -v shellcheck >/dev/null 2>&1; then
    local shellcheck_cmd=(docker container run --rm -i -v "${PWD}:/mnt" koalaman/shellcheck:stable)
  fi

  if ! command -v ruff >/dev/null 2>&1; then
    local ruff_cmd=(docker container run --rm -i -v "${PWD}:/io" -u "$(id -u):$(id -g)" ghcr.io/astral-sh/ruff:0.15.11)
  fi

  find . -type f \
    ! -path "./.git/*" \
    ! -path "./.github/*" \
    ! -path "./.ruff_cache/*" \
    ! -path "./_docs/*" \
    ! -path "./home/.system/wsl/*" \
    ! -name "*.tmpl" \
    -exec sh -c 'head -n 1 "${1}" | grep --quiet -E "^(#!.*sh|# shellcheck shell=)"' _ {} \; \
    -exec "${shellcheck_cmd[@]}" {} +

  "${ruff_cmd[@]}" check "${@}"
}

format() {
  # Format all supported file types
  local shfmt_cmd=(shfmt)
  local ruff_cmd=(ruff)

  if ! command -v shfmt >/dev/null 2>&1; then
    local shfmt_cmd=(docker container run --rm -i -v "${PWD}:/mnt" -u "$(id -u):$(id -g)" -w /mnt mvdan/shfmt:v3)
  fi

  if ! command -v ruff >/dev/null 2>&1; then
    local ruff_cmd=(docker container run --rm -i -v "${PWD}:/io" -u "$(id -u):$(id -g)" ghcr.io/astral-sh/ruff:0.15.11)
  fi

  local shfmt_args=("--write")

  for arg in "${@}"; do
    [ "${arg}" == "--check" ] && shfmt_args+=("--diff")

    if [ "${arg}" == "-d" ] || [ "${arg}" == "--diff" ] || [ "${shfmt_args[1]}" == "--diff" ]; then
      unset "shfmt_args[0]"
    fi
  done

  "${shfmt_cmd[@]}" "${shfmt_args[@]}" . home/dot_config/zsh/dot_aliases
  # shfmt only guesses zsh from a file named .zshrc, not chezmoi's dot_zshrc.
  "${shfmt_cmd[@]}" "${shfmt_args[@]}" -ln=zsh home/dot_config/zsh/dot_zshrc

  "${ruff_cmd[@]}" check --fix
  "${ruff_cmd[@]}" format "${@}"
}

chezmoi:check() {
  # Templates can't be linted as they are, so `lint` skips them. This renders
  # every shell script template (the chezmoi run scripts and the other templates
  # that start with a shebang or a shellcheck directive) for several machine
  # profiles, then checks them with bash -n and, when it's installed, with the
  # linter. Needs chezmoi.
  local repo="${PWD}"
  local tmp=
  tmp="$(mktemp -d)"
  trap 'rm -rf "${tmp}"' RETURN

  if ! command -v chezmoi >/dev/null 2>&1; then
    echo "chezmoi isn't installed, skipping" >&2
    return 0
  fi

  local shellcheck_cmd=(shellcheck)
  command -v shellcheck >/dev/null 2>&1 || shellcheck_cmd=(true)

  # name distro gui wsl container
  local profiles=(
    "fedora-gui fedora true false false"
    "fedora-cli fedora false false false"
    "arch-gui arch true false false"
    "arch-cli arch false false false"
    "debian-cli debian false false false"
    "debian-wsl debian false true false"
    "darwin darwin false false false"
  )

  local profile name distro gui wsl container script rendered failed=0

  for profile in "${profiles[@]}"; do
    read -r name distro gui wsl container <<<"${profile}"

    printf '[data]\n  name = "Test User"\n  email = "test@example.com"\n  signingkey = ""\n' >"${tmp}/${name}.toml"
    printf '  distro = "%s"\n  wsl = %s\n  container = %s\n  gui = %s\n' \
      "${distro}" "${wsl}" "${container}" "${gui}" >>"${tmp}/${name}.toml"

    while IFS= read -r -d '' script; do
      rendered="${tmp}/${name}-${script//\//_}"

      chezmoi --source "${repo}" --config "${tmp}/${name}.toml" execute-template <"${script}" >"${rendered}"

      # Scripts that render to nothing are skipped by chezmoi, that's fine.
      grep -q '[^[:space:]]' "${rendered}" || continue

      # Anything outside of .chezmoiscripts only counts if it's a shell script.
      if [[ "${script}" != home/.chezmoiscripts/* ]]; then
        head -n 1 "${rendered}" | grep -q -E '^(#!.*sh|# shellcheck shell=)' || continue
      fi

      bash -n "${rendered}" || failed=1
      "${shellcheck_cmd[@]}" --shell=bash "${rendered}" || failed=1
    done < <(find home -type f -name '*.tmpl' ! -path 'home/.chezmoitemplates/*' ! -path 'home/.system/*' ! -name '.chezmoi*' -print0)
  done

  [ "${failed}" == "0" ] || return 1
  echo "All scripts render and pass for ${#profiles[@]} profiles"
}

_sys_read() {
  # Print a file, with sudo only when this user can't read it.
  if [ -r "${1}" ]; then
    cat -- "${1}"
  else
    sudo cat -- "${1}"
  fi
}

_sys_scopes() {
  # The folders of home/.system/files/ that apply to this machine.
  local distro gui
  read -r distro gui <<<"$(chezmoi --source "${1}" execute-template '{{ .distro }} {{ .gui }}')"

  if [ -z "${distro}" ]; then
    echo "Couldn't read the distro of this machine, has 'chezmoi init' been run?" >&2
    return 1
  fi

  echo "all"
  echo "${distro}"

  if [ "${gui}" == "true" ]; then
    echo "gui"
    echo "${distro}-gui"
  fi
}

sys:add() {
  # Copy a file from outside of $HOME into the repo, so that `chezmoi apply`
  # installs it on every machine it applies to (see home/.system/files/). Run it
  # again on a file to update the copy. Files in $HOME are for `chezmoi add`.
  #
  #   ./run sys:add /etc/greetd/config.toml
  #   ./run sys:add --scope fedora-gui /etc/greetd/config.toml
  #
  # Scopes: all (the default), gui, fedora, arch, debian, fedora-gui, arch-gui,
  # debian-gui. Files that aren't world readable are refused unless you pass
  # --force, they may hold secrets and the repo is public.
  local repo scope="all" force=0 path mode dest
  local -a paths=()
  repo="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

  while (("${#}")); do
    case "${1}" in
    --scope)
      scope="${2:-}"
      shift 2 || shift
      ;;
    --force)
      force=1
      shift
      ;;
    *)
      paths+=("${1}")
      shift
      ;;
    esac
  done

  if ((${#paths[@]} == 0)) || ! [[ "${scope}" =~ ^(all|gui|(arch|debian|fedora)(-gui)?)$ ]]; then
    echo "Usage: ./run sys:add [--scope all|gui|fedora|arch|debian|<distro>-gui] [--force] <absolute path>..." >&2
    return 1
  fi

  for path in "${paths[@]}"; do
    if [[ "${path}" != /* ]] || [[ "${path}/" == */../* ]]; then
      echo "${path}: needs an absolute path without '..'" >&2
      return 1
    elif [[ "${path}" == "${HOME}"/* || "${path}" == /home/* || "${path}" == /root/* ]]; then
      echo "${path}: that's in a home directory, use 'chezmoi add' for it" >&2
      return 1
    elif [ -L "${path}" ]; then
      echo "${path}: is a symlink, add the file it points to" >&2
      return 1
    elif [ -d "${path}" ]; then
      echo "${path}: is a directory, add its files one by one" >&2
      return 1
    elif [ ! -f "${path}" ]; then
      echo "${path}: no such file" >&2
      return 1
    fi

    mode="$(stat -c %a -- "${path}")"

    if ! ((8#${mode} & 4)) && [ "${force}" == "0" ]; then
      echo "${path}: mode ${mode}, not world readable. It may hold secrets and this repo is public, pass --force to add it anyway" >&2
      return 1
    fi

    dest="${repo}/home/.system/files/${scope}${path}"

    mkdir -p -- "$(dirname -- "${dest}")"
    _sys_read "${path}" >"${dest}.new"
    mv -- "${dest}.new" "${dest}"

    # Git only remembers whether a file is executable.
    if ((8#${mode} & 8#111)); then
      chmod 755 -- "${dest}"
    else
      chmod 644 -- "${dest}"
    fi

    echo "${path} -> ${dest#"${repo}/"}"
  done

  echo "Installed by 'chezmoi apply' from now on (the system files script runs again)."
}

sys:diff() {
  # Compare the system files in the repo with what is installed in / on this
  # machine, exits with 1 when something differs. For edits made directly in
  # /etc that you want to keep, run sys:add on the file again.
  local repo scopes scope scope_dir src dest differs=0
  repo="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  scopes="$(_sys_scopes "${repo}")"

  while IFS= read -r scope; do
    scope_dir="${repo}/home/.system/files/${scope}"
    [ -d "${scope_dir}" ] || continue

    while IFS= read -r -d '' src; do
      dest="/${src#"${scope_dir}/"}"

      if ! [ -e "${dest}" ] && ! sudo test -e "${dest}"; then
        echo "missing: ${dest}"
        differs=1
      elif ! diff -u --label "installed ${dest}" --label "repo ${src#"${repo}/"}" <(_sys_read "${dest}") "${src}"; then
        differs=1
      fi
    done < <(find "${scope_dir}" -type f -print0 | sort -z)
  done <<<"${scopes}"

  if [ "${differs}" == "0" ]; then
    echo "The system files match the repo"
  fi

  return "${differs}"
}

quality() {
  # Perform all code quality commands together
  lint "${@}"
  format "${@}"
}

ci:test() {
  # Execute Continuous Integration (CI) pipeline
  lint
  format --check --diff
  chezmoi:check
}

help() {
  printf "%s <task> [args]\n\nTasks:\n" "${0}"

  compgen -A function | grep -v "^_" | cat -n

  printf "\nExtended help:\n  Each task has comments for general usage\n"
}

TIMEFORMAT=$'\nTask completed in %3lR'
time "${@:-help}"
