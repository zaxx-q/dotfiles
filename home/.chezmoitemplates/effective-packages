{{- /*
  Prints EFFECTIVE_PACKAGES=( ... ) with every system package that is going to
  be installed on this machine, for scripts that need to know ("is docker
  installed?"). It's the equivalent of dotfriedrice's _has_package.

  Each list is (base + extras) - skip, one quoted name per line. This doesn't
  call the pkglist template on purpose: includeTemplate can't resolve nested
  templates, and the system-files template reads this output with it.
*/ -}}
{{- $p := .packages -}}
{{- $groups := list -}}
{{- if eq .distro "fedora" -}}
{{-   $groups = append $groups (dict "base" $p.fedora.cli "extras" $p.fedora.cli_extras "skip" $p.fedora.cli_skip) -}}
{{-   if .gui -}}
{{-     $groups = append $groups (dict "base" $p.fedora.gui "extras" $p.fedora.gui_extras "skip" $p.fedora.gui_skip) -}}
{{-   end -}}
{{- else if eq .distro "arch" -}}
{{-   $groups = append $groups (dict "base" $p.arch.cli "extras" $p.arch.cli_extras "skip" $p.arch.cli_skip) -}}
{{-   $groups = append $groups (dict "base" $p.arch.aur "extras" $p.arch.aur_extras "skip" $p.arch.aur_skip) -}}
{{-   if .gui -}}
{{-     $groups = append $groups (dict "base" $p.arch.gui "extras" $p.arch.gui_extras "skip" $p.arch.gui_skip) -}}
{{-     $groups = append $groups (dict "base" $p.arch.aur_gui "extras" $p.arch.aur_gui_extras "skip" $p.arch.aur_gui_skip) -}}
{{-   end -}}
{{- else if eq .distro "debian" -}}
{{-   $groups = append $groups (dict "base" $p.debian.cli "extras" $p.debian.cli_extras "skip" $p.debian.cli_skip) -}}
{{- else if eq .distro "darwin" -}}
{{-   $groups = append $groups (dict "base" $p.darwin.brew "extras" $p.darwin.brew_extras "skip" $p.darwin.brew_skip) -}}
{{-   $groups = append $groups (dict "base" $p.darwin.cask "extras" $p.darwin.cask_extras "skip" $p.darwin.cask_skip) -}}
{{- end -}}
EFFECTIVE_PACKAGES=(
{{- range $groups }}
{{-   $skip := .skip }}
{{-   range (concat .base .extras) }}
{{-     if not (has . $skip) }}
  {{ . | quote }}
{{-     end }}
{{-   end }}
{{- end }}
)

_has_package() {
  local package
  for package in "${EFFECTIVE_PACKAGES[@]}"; do
    [[ "${package}" == "${1}" ]] && return 0
  done
  return 1
}
