;; Kanata configuration — replaces keyd /etc/keyd/default.conf
;;
;; CapsLock: tap → Esc, hold → Meta (Super)
;; Japanese keyboard ergonomic remappings
;; Muhenkan held → nav layer (vim-style hjkl + u/d)

(defcfg
  process-unmapped-keys yes
)

(defsrc
  esc
  caps
  henkan
  muhenkan
  katakanahiragana
  ¥
  ro
  a  h  j  k  l  ;  u  d
)

(defalias
  ;; CapsLock: tap → Esc, hold → Meta
  ;; Mirrors keyd's `capslock = overload(meta, esc)` with `overload_tap_timeout = 250`:
  ;;
  ;;   * Meta goes down the instant CapsLock is pressed (like keyd), so Super+mouse
  ;;     and Super+key chords work immediately.
  ;;   * Esc is sent ONLY if CapsLock is released within 250ms AND no other key was
  ;;     pressed while it was down. In that case Meta is released and Esc is tapped
  ;;     once (press + release). Esc is never held.
  ;;   * Pressing any other key while CapsLock is down => it's a Meta chord, no Esc.
  ;;   * Holding longer than 250ms => just Meta, no Esc.
  ;;
  ;; IMPORTANT: the FIRST number of tap-hold-press (tap-repress-timeout) must stay 0.
  ;; keyd has no such feature. In kanata, if it is non-zero, then tapping and
  ;; re-pressing the key within that window runs the TAP action immediately and
  ;; HOLDS it until you let go => double-tapping CapsLock held Esc (and the OS
  ;; then auto-repeats it). 0 disables that behaviour.
  ;;
  ;; Also keep `process-unmapped-keys yes` in defcfg: it makes kanata see ALL keys,
  ;; so that pressing any key (even ones not listed in defsrc) cancels the Esc.
  cap (multi
        lmet
        (tap-hold-press 0 250
          (multi (release-key lmet) esc)  ;; tap: undo Meta, send Esc once
          XX                              ;; hold: nop (Meta already active)
        )
      )

  ;; Muhenkan: hold → nav layer
  nav (layer-toggle nav)
)

(deflayer default
  esc           ;; esc → pass through (was commented out in keyd)
  @cap          ;; caps → tap Esc / hold Meta
  bspc          ;; henkan → backspace
  @nav          ;; muhenkan → hold for nav layer
  caps          ;; katakanahiragana → capslock
  menu          ;; yen → compose (KEY_COMPOSE, aliased as <MENU> in XKB)
  lsft          ;; ro → shift
  a  h  j  k  l  ;  u  d
)

(deflayer nav
  _
  _
  _
  _
  _
  _
  _
  home  left  down  up  right  end  pgup  pgdn
)
