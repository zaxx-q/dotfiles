{{- /*
  Things chezmoi downloads for you on `chezmoi apply`.
  Refresh them with: chezmoi apply --refresh-externals
*/ -}}

# tmux plugin manager. The plugins it manages (see tmux.conf) get installed by
# .chezmoiscripts/run_onchange_after_32-tmux-plugins.sh.tmpl.
[".config/tmux/plugins/tpm"]
  type = "git-repo"
  url = "https://github.com/tmux-plugins/tpm.git"
  refreshPeriod = "168h"
  [".config/tmux/plugins/tpm".clone]
    args = ["--depth", "1"]
  [".config/tmux/plugins/tpm".pull]
    args = ["--ff-only"]

# uosc: modern mpv on-screen controls.
[".config/mpv/scripts/uosc"]
  type = "archive"
  url = "https://github.com/tomasklaen/uosc/releases/latest/download/uosc.zip"
  stripComponents = 2
  include = ["scripts/uosc/**"]
  refreshPeriod = "168h"

[".config/mpv/fonts"]
  type = "archive"
  url = "https://github.com/tomasklaen/uosc/releases/latest/download/uosc.zip"
  stripComponents = 1
  include = ["fonts/**"]
  refreshPeriod = "168h"

# mpv-mpris2: MPRIS v2 D-Bus interface for mpv (media keys, playerctl, desktop integration).
# Extracts the static binary; mpv auto-loads it via the .run extension.
[".config/mpv/scripts/mpris.run"]
  type = "archive-file"
  url = "https://github.com/eNV25/mpv-mpris2/releases/latest/download/mpv-mpris2-x86_64-unknown-linux-musl.tar.zst"
  path = "mpv-mpris2-x86_64-unknown-linux-musl/mpv-mpris2"
  refreshPeriod = "168h"
  executable = true

# sponsorblock-minimal: mark/skip sponsor segments in YouTube videos.
[".config/mpv/scripts/sponsorblock_minimal.lua"]
  type = "file"
  url = "https://codeberg.org/jouni/mpv_sponsorblock_minimal/raw/branch/master/sponsorblock_minimal.lua"
  refreshPeriod = "168h"

# thumbfast: thumbnail previews on the seek bar (pairs with uosc).
[".config/mpv/scripts/thumbfast.lua"]
  type = "file"
  url = "https://raw.githubusercontent.com/po5/thumbfast/master/thumbfast.lua"
  refreshPeriod = "168h"

# selectformat: menu to pick stream quality/format for YouTube.
[".config/mpv/scripts/selectformat.lua"]
  type = "file"
  url = "https://raw.githubusercontent.com/koonix/mpv-selectformat/master/selectformat.lua"
  refreshPeriod = "168h"

# nnedi3 upscaling shader.
[".config/mpv/shaders/nnedi3-nns128-win8x4.hook"]
  type = "file"
  url = "https://raw.githubusercontent.com/bjin/mpv-prescalers/master/nnedi3-nns128-win8x4.hook"
  refreshPeriod = "720h"

# ArtCNN upscaling shader.
[".config/mpv/shaders/ArtCNN_C4F32.glsl"]
  type = "file"
  url = "https://raw.githubusercontent.com/Artoriuz/ArtCNN/main/GLSL/ArtCNN_C4F32.glsl"
  refreshPeriod = "720h"

{{- /* Standalone scripts, replaces SCRIPTS_INSTALL. */ -}}
{{- $skip := .external_scripts.skip -}}
{{- $scripts := concat .external_scripts.default .external_scripts.extras -}}
{{ range $scripts }}
{{-   if not (has .name $skip) }}

[".local/bin/{{ .name }}"]
  type = "file"
  url = {{ .url | quote }}
  executable = true
{{-   end }}
{{- end }}
