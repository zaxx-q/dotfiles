{{- if and (eq .chezmoi.os "linux") (ne .distro "unsupported") -}}
{{- /* The folders of .system/files/ that apply to this machine. */ -}}
{{- $scopes := list "all" .distro -}}
{{- if .gui }}{{ $scopes = concat $scopes (list "gui" (printf "%s-gui" .distro)) }}{{ end -}}
#!/usr/bin/env bash
# Files that live outside of $HOME (/etc, /usr/share, ...). chezmoi can only
# manage $HOME, so these are copied with sudo. This replaces the `sudo ln -fns`
# / `sudo install` entries of CONFIG_INSTALL_* in the old dotfriedrice setup.
#
# The sources are in .system/ of this repo. This script runs again whenever one
# of them changes, the hashes below are what makes that happen.
#
# Most files don't need to be listed here. Everything in .system/files/<scope>/
# is installed to the same path under /, see the SYSTEM_SCOPES loop below. Add
# one with `./run sys:add /etc/some/file`.
#
# kanata:             {{ include ".system/etc/kanata/config.kbd" | sha256sum }}
# dnf.conf:           {{ include ".system/etc/dnf/dnf.conf" | sha256sum }}
# pacman-contrib:     {{ include ".system/etc/conf.d/pacman-contrib" | sha256sum }}
# wayland session:    {{ include ".system/usr/share/wayland-sessions/niri-uwsm.desktop" | sha256sum }}
# networkd timeout:   {{ include ".system/etc/systemd/system/systemd-networkd-wait-online.service.d/99-network-timeout.conf" | sha256sum }}
# wsl.conf:           {{ include ".system/etc/wsl.conf" | sha256sum }}
# windows terminal:   {{ include ".system/wsl/windows-terminal-settings.json" | sha256sum }}
# mask services:      {{ .mask_services | toJson | sha256sum }}
{{- range $scope := $scopes }}
{{-   range (glob (printf "%s/.system/files/%s/**/*" $.chezmoi.sourceDir $scope)) }}
{{-     if not (stat .).isDir }}
{{-       $rel := trimPrefix (printf "%s/" $.chezmoi.sourceDir) . }}
# {{ $rel }}: {{ include $rel | sha256sum }}
{{-     end }}
{{-   end }}
{{- end }}
{{ template "prelude" . }}

{{ template "effective-packages" . }}

SYSTEM_DIR="{{ .chezmoi.sourceDir }}/.system"

_info "INSTALL SYSTEM FILES"

# Copy a file to a root owned location, but only when it differs.
_sys_install() {
  local src="${1}"
  local dest="${2}"
  local mode="${3:-644}"

  # A symlink is what the old dotfriedrice setup created, replace it with a
  # real file so the repo is no longer referenced from /etc.
  if sudo test -L "${dest}"; then
    sudo rm -f "${dest}"
  fi

  if sudo test -f "${dest}" && sudo cmp -s "${src}" "${dest}"; then
    _skipping "'${dest}' didn't change"
  else
    sudo install -Dm"${mode}" "${src}" "${dest}"
    echo "'${dest}' has been installed"
  fi
}

# Keep a one time backup of a real file that is about to be replaced.
_sys_backup_once() {
  local path="${1}"

  if sudo test -f "${path}" && ! sudo test -L "${path}" && ! sudo test -e "${path}.bak"; then
    sudo cp -a "${path}" "${path}.bak"
    echo "Backed up '${path}' to '${path}.bak'"
  fi
}

# kanata key remapping, only when kanata is one of the packages of this machine.
if _has_package "kanata"; then
  kanata_changed=1
  if sudo test -f /etc/kanata/config.kbd && sudo cmp -s "${SYSTEM_DIR}/etc/kanata/config.kbd" /etc/kanata/config.kbd; then
    kanata_changed=0
  fi

  _sys_install "${SYSTEM_DIR}/etc/kanata/config.kbd" /etc/kanata/config.kbd

  if [ "${kanata_changed}" == "1" ] && systemctl is-active --quiet kanata.service 2>/dev/null; then
    sudo systemctl restart kanata.service || true
  fi
fi

{{ if .gui }}
# The niri session that gets listed in your display / login manager.
if [ "${GUI_ENABLED}" == "1" ]; then
  _sys_install "${SYSTEM_DIR}/usr/share/wayland-sessions/niri-uwsm.desktop" /usr/share/wayland-sessions/niri-uwsm.desktop

{{- if not (has "networkd-wait-online-timeout" .skip.system) }}

  _sys_install "${SYSTEM_DIR}/etc/systemd/system/systemd-networkd-wait-online.service.d/99-network-timeout.conf" \
    /etc/systemd/system/systemd-networkd-wait-online.service.d/99-network-timeout.conf
{{- end }}
fi
{{ end }}

{{ if or (eq .distro "arch") (eq .distro "fedora") }}
# Both distros use the systemd-resolved stub resolver. Leave WSL and containers
# alone since they manage /etc/resolv.conf themselves.
if [[ "${OS_IN_WSL}" != "1" && "${OS_IN_CONTAINER}" != "1" ]]; then
  if [ "$(readlink /etc/resolv.conf || true)" != "/run/systemd/resolve/stub-resolv.conf" ]; then
    sudo ln -fns /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
    echo "'/etc/resolv.conf' now points to the systemd-resolved stub"
  else
    _skipping "'/etc/resolv.conf' already points to the systemd-resolved stub"
  fi
fi
{{ end }}

{{ if eq .distro "arch" }}
# Arch (pacman-contrib, which provides paccache).
_sys_backup_once /etc/conf.d/pacman-contrib
_sys_install "${SYSTEM_DIR}/etc/conf.d/pacman-contrib" /etc/conf.d/pacman-contrib

# A symlink here is a leftover of the old setup, an optional 02-ignore.conf is
# not part of this repo anymore. A real file is yours and gets left alone.
if sudo test -L /etc/pacman.d/02-ignore.conf; then
  sudo rm -f /etc/pacman.d/02-ignore.conf
fi
{{ end }}

{{ if eq .distro "fedora" }}
# Fedora (DNF options such as parallel downloads and fastest mirror).
_sys_backup_once /etc/dnf/dnf.conf
_sys_install "${SYSTEM_DIR}/etc/dnf/dnf.conf" /etc/dnf/dnf.conf
{{ end }}

# Everything in .system/files/<scope>/ is installed to the same path under /.
# The scopes of this machine are: {{ join ", " $scopes }}.
# A file that is executable in the repo gets mode 755, the others 644.
SYSTEM_SCOPES=({{ range $scopes }}{{ . | quote }} {{ end }})

for scope in "${SYSTEM_SCOPES[@]}"; do
  scope_dir="${SYSTEM_DIR}/files/${scope}"
  [ -d "${scope_dir}" ] || continue

  while IFS= read -r -d '' src; do
    dest="/${src#"${scope_dir}/"}"
    mode=644
    if [ -x "${src}" ]; then
      mode=755
    fi

    # Keep a one time backup of a real file that this is about to replace.
    if sudo test -f "${dest}" && ! sudo cmp -s "${src}" "${dest}"; then
      _sys_backup_once "${dest}"
    fi

    _sys_install "${src}" "${dest}" "${mode}"
  done < <(find "${scope_dir}" -type f -print0 | sort -z)
done

{{ if .wsl }}
# WSL 2
_sys_install "${SYSTEM_DIR}/etc/wsl.conf" /etc/wsl.conf

# shellcheck disable=SC2016
windows_user="$(powershell.exe '$env:UserName' 2>/dev/null | tr -d '\r\n' || true)"

if [ -n "${windows_user}" ]; then
  windows_terminal_dir="/mnt/c/Users/${windows_user}/AppData/Local/Packages/Microsoft.WindowsTerminal_8wekyb3d8bbwe/LocalState"

  if [ -d "${windows_terminal_dir}" ]; then
    cp "${SYSTEM_DIR}/wsl/windows-terminal-settings.json" "${windows_terminal_dir}/settings.json" || true
    echo "Windows Terminal settings copied to '${windows_terminal_dir}'"
  else
    _warning "Windows Terminal's settings directory wasn't found for '${windows_user}', skipping"
  fi
else
  _warning "Could not determine your Windows user name, skipping the Windows Terminal settings"
fi
{{ end }}

{{ if .mask_services }}
# Units that slow down boot and aren't needed.
{{- range .mask_services }}
if command -v systemctl >/dev/null 2>&1 && systemctl cat {{ . | quote }} >/dev/null 2>&1; then
  if [ "$(systemctl is-enabled {{ . | quote }} 2>/dev/null || true)" != "masked" ]; then
    sudo systemctl disable {{ . | quote }} || true
    sudo systemctl mask {{ . | quote }}
    echo "'{{ . }}' has been disabled and masked"
  else
    _skipping "'{{ . }}' is already masked"
  fi
fi
{{- end }}
{{ end }}
{{- end }}
