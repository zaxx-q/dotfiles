// Niri config
//
// Wiki: https://github.com/YaLTeR/niri/wiki/Configuration:-Introduction
// KDL:  https://kdl.dev  ("/-" comments out the following node)
//
// Order of this file:
//   Startup > Input > Outputs > Behavior > Layout > Rules > Key binds > Includes
//
// Notes:
//   - Binds are grouped with `// #"Category"` comments so the Noctalia
//     Keybind Cheatsheet (Mod+F1) can sort them into sections.
//   - Blocks marked "Toggleable" or "Glass styling" are kept exactly as they
//     were: the toggle-niri-* scripts may look for them.

// ----------------------------------------------------------------------------
// Startup
// ----------------------------------------------------------------------------

environment {}

// Start dms in systemd autostart instead to make xdg autostart apps after dms.
// spawn-at-startup "dms" "run"
spawn-at-startup "uwsm-app" "-s" "b" "--" "noctalia"

// spawn-at-startup "swayidle" "-w"
// spawn-at-startup "waybar"
spawn-sh-at-startup "sleep 1; uwsm-app -s b mpd-mpris"
// spawn-at-startup "kdeconnectd"

// ----------------------------------------------------------------------------
// Input
// https://github.com/YaLTeR/niri/wiki/Configuration:-Input
// ----------------------------------------------------------------------------

input {
    keyboard {
        xkb {
            // You can set rules, model, layout, variant and options.
            // For more information, see xkeyboard-config(7).

            // For example:
            // layout "us,ru"
            // options "grp:win_space_toggle,compose:ralt,ctrl:nocaps"

            // If this section is empty, niri will fetch xkb settings
            // from org.freedesktop.locale1. You can control these using
            // localectl set-x11-keymap.

            // Map the Compose Key
            options "compose:menu"
            // Swap caps lock and escape.
            // Remap menu key to act as an extra super / mod key.
            // options "caps:swapescape,altwin:menu_win"
        }

        // A fairly fast repeat rate and delay.
        repeat-delay 200
        repeat-rate 40
        // Enable numlock on startup, omitting this setting disables it.
        numlock
    }

    // Next sections include libinput settings.
    // Omitting settings disables them, or leaves them at their default values.
    // All commented-out settings here are examples, not defaults.
    touchpad {
        // Tapping anywhere registers a left click.
        tap
        dwt
        dwtp
        // drag false
        // drag-lock
        // Inverted scrolling.
        natural-scroll
        accel-speed 0.7
        // Disable acceleration.
        accel-profile "flat"
        // scroll-method "two-finger"
        click-method "button-areas"
        // middle-emulation
    }

    mouse {
        // off
        // natural-scroll
        // Disable acceleration.
        accel-profile "flat"
        // accel-speed 0.0 (default)
        // Faster scrolling with the mouse wheel.
        scroll-factor 2.0
        // scroll-method "on-button-down"
        // scroll-button 274
        // scroll-button-lock
    }

    trackpoint {
        // off
        // natural-scroll
        accel-speed 0.6
        accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // scroll-button-lock
        // middle-emulation
    }

    // Uncomment this to make the mouse warp to the center of newly focused windows.
    // warp-mouse-to-focus

    // Focus windows and outputs automatically when moving the mouse into them.
    // Setting max-scroll-amount="0%" makes it work only on windows already fully on screen.
    // focus-follows-mouse max-scroll-amount="0%"
}

// Runtime touchpad state, managed by toggle-niri-touchpad.
// Must stay after the input block so it can override it.
include optional=true "touchpad-disabled.kdl"

// ----------------------------------------------------------------------------
// Outputs
// Find names with `niri msg outputs`.
// https://github.com/YaLTeR/niri/wiki/Configuration:-Outputs
// ----------------------------------------------------------------------------

output "eDP-1" {
    mode "1920x1080@60.056"
    position x=0 y=0
}

// ----------------------------------------------------------------------------
// Behavior
// ----------------------------------------------------------------------------

// Avoid writing screenshots to disk since they get piped into satty.
screenshot-path null
// screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Disable the primary selection, including standard middle-click paste.
clipboard {
    disable-primary
}

hotkey-overlay {
    // Avoid auto-showing the important hotkeys menu.
    skip-at-startup
}

gestures {
    // Disable overview when mousing over the top left of the primary screen.
    hot-corners {
        off
    }
}

// Remove window decorations (requires opening and closing each app to change).
prefer-no-csd

// Disable workspace shadows in the overview.
overview {
    workspace-shadow {
        off
    }
}

recent-windows {
    previews {
        max-height 200
        max-scale 0.2
    }

    // Disabled: override the Alt+Tab switcher binds.
    /-binds {
        // Override to disable super+tab
        Alt+Tab         { next-window scope="output"; }
        Alt+Shift+Tab   { previous-window scope="output"; }
        Alt+grave       { next-window filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
}

debug {
    honor-xdg-activation-with-invalid-serial
}

// Currently handled by logind.conf, uncomment to control it here.
/-switch-events {
    lid-close { spawn "noctalia" "msg" "session" "lock-and-suspend"; }
}

/-animations {
    // Uncomment to turn off all animations.
    // You can also put "off" into each individual animation to disable it.
    // off

    // Slow down all animations by this factor. Values below 1 speed them up instead.
    // slowdown 3.0

    // Individual animations.
    workspace-switch {
        spring damping-ratio=0.80 stiffness=523 epsilon=0.0001
    }
    window-open {
        duration-ms 150
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }
    horizontal-view-movement {
        spring damping-ratio=0.85 stiffness=423 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.75 stiffness=323 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.85 stiffness=423 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.65 stiffness=923 epsilon=0.001
    }
    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }
    overview-open-close {
        spring damping-ratio=0.85 stiffness=800 epsilon=0.0001
    }
    recent-windows-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.001
    }
}

// ----------------------------------------------------------------------------
// Layout
// https://github.com/YaLTeR/niri/wiki/Configuration:-Layout
// ----------------------------------------------------------------------------

// Settings that influence how windows are positioned and sized.
// Find more information on the wiki:
// https://github.com/YaLTeR/niri/wiki/Configuration:-Layout
layout {
    // Set gaps around windows in logical pixels.
    gaps 1

    // Focus ring
    focus-ring {
        width 1
    }
    /-border {
        // off
        // width 2
        // active-color   "#707070"      // Neutral gray
        // inactive-color "#d0d0d0"      // Light gray
        // urgent-color   "#cc4444"      // Softer red
    }
    /-shadow {
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
    // Toggleable struts
    struts {
        left 64
        right 64
        top 10
        bottom 10
    }

    // Show tab state so cast targets remain identifiable in tabbed columns.
    tab-indicator {
        hide-when-single-tab
        place-within-column
        gap 5
        width 4
        length total-proportion=1.0
        position "right"
        gaps-between-tabs 2
        corner-radius 8
        active-color "red"
        inactive-color "gray"
        urgent-color "blue"
    }

    // Set transparent workspace background color so the backdrop is visible at all times.
    background-color "transparent"

    // When to center a column when changing focus, options are:
    // - "never", default behavior, focusing an off-screen column will keep at the left
    //   or right edge of the screen.
    // - "always", the focused column will always be centered.
    // - "on-overflow", focusing a column will center it if it doesn't fit
    //   together with the previously focused column.
    center-focused-column "never"
    // always-center-single-column
    // You can customize the widths that "switch-preset-column-width" (Mod+R) toggles between.
    /-preset-column-widths {
        // Proportion sets the width as a fraction of the output width, taking gaps into account.
        // For example, you can perfectly fit four windows sized "proportion 0.25" on an output.
        // The default preset widths are 1/3, 1/2 and 2/3 of the output.
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        // Fixed sets the width in logical pixels exactly.
        // fixed 1920
    }
    // You can also customize the heights that "switch-preset-window-height" (Mod+Shift+R) toggles between.
    // preset-window-heights { }
    // You can change the default width of the new windows.
    // default-column-width { proportion 0.5; }
    // If you leave the brackets empty, the windows themselves will decide their initial width.
    // default-column-width {}
    // By default focus ring and border are rendered as a solid background rectangle
    // behind windows. That is, they will show up through semitransparent windows.
    // This is because windows using client-side decorations can have an arbitrary shape.
    //
    // If you don't like that, you should uncomment `prefer-no-csd` below.
    // Niri will draw focus ring and border *around* windows that agree to omit their
    // client-side decorations.
    //
    // Alternatively, you can override it with a window rule called
    // `draw-border-with-background`.
}

// ----------------------------------------------------------------------------
// Rules
// https://github.com/YaLTeR/niri/wiki/Configuration:-Window-Rules
// ----------------------------------------------------------------------------

// Place the regular wallpaper on the backdrop.
layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}

// Make an actively cast window unmistakable, whether it is focused or not.
window-rule {
    match is-window-cast-target=true

    // Keep the normal 1px ring to avoid resizing the cast target.
    focus-ring {
        on
        width 1
        active-color "#ffcc00"
        inactive-color "#ff9500"
    }

    shadow {
        on
        softness 18
        spread 10
        offset x=0 y=0
        color "#ff950080"
    }

    tab-indicator {
        active-color "#ffcc00"
        inactive-color "#ff9500"
    }
}

window-rule {
    // Slight rounded corners.
    // Toggleable corner-radius
    geometry-corner-radius 20
    clip-to-geometry true
    draw-border-with-background false
}

// Glass styling
    /-window-rule {
    opacity 0.75
    background-effect {
        xray true
        blur true
        // noise 0.05
        // saturation 3
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#00000080"
    }
}

// Float these by default.
window-rule {
    match app-id=r#"^Pinentry-gtk$"#
    match app-id=r#"^Tk$"#
    match app-id=r#"^gimp$"# title=r#"Preferences"#
    match app-id=r#"^mpv$"#
    match app-id=r#"^soffice$"# title=r#"^Text Import"#
    match app-id=r#"^[tT]hunar$"# title=r#"^(Rename |File Operation )"#
    match app-id=r#"^virt-manager$"# title=r#" - Connection Details"#
    match app-id=r#"^wev$"#
    match app-id=r#"^xarchiver$"#
    match app-id=r#"^zenity$"#
    match app-id=r#"^java-lang-Thread$"#
    match app-id=r#"^com-abdownloadmanager-desktop-AppKt$"#
    match app-id=r#"zen$"# title=r#"^(Picture-in-Picture|Library|About Mozilla Firefox|Firefox - Choose a profile)$"#
    match app-id="zoom"
    // match app-id=r#"^galculator$"#
    // match app-id=r#"^blueman-manager$"#
    match app-id=r#"^xdg-desktop-portal"#
    match app-id=r#"^exo-desktop-item-edit$"#
    match app-id=r#"^Toplevel$"#
    match app-id=r#"^flameshot$"#
    open-floating true
}

// Floating kitty / thunar helpers.
window-rule {
    match app-id=r#"^dfr\.floating\.kitty$"#
    match app-id=r#"^dfr\.floating\.thunar$"#

    open-floating true
    default-column-width { proportion 0.33; }
    default-window-height { proportion 0.5; }
}

window-rule {
    match app-id=r#"^dfr\.floating\.filechooser$"#

    open-floating true
    default-column-width { proportion 0.6; }
    default-window-height { proportion 0.65; }
}

// Screenshot annotation tools.
window-rule {
    match app-id=r#"^com\.gabm\.satty$"#
    match app-id=r#"^dev\.tensaku\.Tensaku$"#
    open-floating true
    min-width 730
    min-height 300
}

// Small settings windows.
window-rule {
    match app-id=r#"^gnome-control-center$"#
    match app-id=r#"pavucontrol$"#
    match app-id=r#"^nm-connection-editor$"#
    default-column-width { proportion 0.3; }
    default-window-height { proportion 0.5; }
    open-floating true
}

// Widgets: tiny floating windows in the bottom-right corner, never take focus.
window-rule {
    match title=r#"Widget$"#
    open-floating true
    open-focused false
    default-floating-position x=10 y=10 relative-to="bottom-right"
    default-window-height { proportion 0.04; }
    default-column-width { proportion 0.15; }
}

window-rule {
    match app-id="Waydroid"
    // open-floating true
    default-window-height { proportion 1.0; }
    default-column-width { proportion 0.33333; }
    open-maximized-to-edges false
}

// Open Noctalia windows as floating by default.
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

window-rule {
    match app-id=r#"^resolve$"#
    open-floating true
}

// Disabled rules. Remove "/-" to enable.
/-window-rule {
    match app-id="scratchpad"
    open-floating true
    default-window-height { proportion 0.9; }
    default-column-width { proportion 0.9; }
    open-maximized-to-edges false
    open-on-workspace "scratch"
}

/-window-rule {
    match app-id=r#"^KeePassXC$"#
    // match namespace="^dms:clipboard$"

    block-out-from "screencast"
}

/-window-rule {
    match app-id=r#"^steam$"# title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

/-window-rule {
    // match app-id=r#"^org\.wezfurlong\.wezterm$"#
    // match app-id="Alacritty"
    match app-id=r#"^zen$"#
    match app-id="kitty"
    draw-border-with-background false
}

/-window-rule {
    match app-id=r#"^org\.gnome\."#
    draw-border-with-background false
    geometry-corner-radius 12
    clip-to-geometry true
}

// ----------------------------------------------------------------------------
// Key binds
//
// Every Mod+<letter> is already taken; new binds need Alt / Ctrl / Shift.
// ----------------------------------------------------------------------------

binds {
    // #"Noctalia"
    Mod+Space        hotkey-overlay-title="Launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+Alt+N        hotkey-overlay-title="Control center" { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+Alt+Comma    hotkey-overlay-title="Settings" { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+V            hotkey-overlay-title="Clipboard" { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+Grave        hotkey-overlay-title="Session" { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Alt+Grave        hotkey-overlay-title="Window switcher" { spawn "noctalia" "msg" "window-switcher"; }
    // Niri has a built-in window switcher you might want to try it to see which one you prefer.
    Mod+Shift+Space  hotkey-overlay-title="Bar toggle" repeat=false { spawn "noctalia" "msg" "bar-toggle"; }
    Mod+F1           hotkey-overlay-title="Keybind cheatsheet" { spawn "noctalia" "msg" "panel-toggle" "kenn/keybind-cheatsheet:cheatsheet"; }

    // #"Applications"
    Mod+Return         hotkey-overlay-title="Terminal" { spawn "uwsm-app" "--" "kitty" "--single-instance"; }
    Mod+Alt+Return     hotkey-overlay-title="Terminal (floating)" { spawn "kitty" "--single-instance" "--class=dfr.floating.kitty"; }
    Mod+G              hotkey-overlay-title="File manager" { spawn "uwsm-app" "thunar"; }
    Mod+Alt+G          hotkey-overlay-title="File manager (floating)" repeat=false { spawn "dbus-run-session" "thunar" "--name=dfr.floating.thunar" "downloads"; }
    Mod+J              hotkey-overlay-title="File manager (zoxide)" repeat=false { spawn "bash" "-c" "choice=$(zoxide query -l | noctalia dmenu -p 'zoxide'); if [ -n \"$choice\" ]; then zoxide add \"$choice\"; niri msg action spawn -- thunar \"$choice\"; fi"; }
    Mod+H              hotkey-overlay-title="Favorite files" repeat=false { spawn "noctalia" "msg" "panel-toggle" "dunarand/bookmarks:panel" "search"; }
    // Mod+Alt+N          hotkey-overlay-title="Notes" { spawn "dfr-launch-or-focus-tui" "notes"; }
    // Mod+Ctrl+N         hotkey-overlay-title="Notes (directory)" { spawn-sh "dfr-launch-or-focus-tui ${EDITOR} ${NOTES_DIRECTORY}"; }
    // Mod+Alt+P          hotkey-overlay-title="Passwords" { spawn "dfr-launch-or-focus" "keepassxc"; }
    // Mod+Alt+Shift+P    hotkey-overlay-title="Generate random password to clipboard" { spawn "pw"; }
    Mod+B              hotkey-overlay-title="Browser" { spawn "launch-or-cycle" "zen:zen-browser"; }
    // Mod+Alt+B          hotkey-overlay-title="Browser (private)" { spawn "zen-browser" "-private-window"; }
    Mod+Alt+B         hotkey-overlay-title="Browser (isolated profile)" { spawn-sh "zen-browser -P ${BROWSER_ISOLATED_PROFILE:-isolated}"; }
    Mod+M              hotkey-overlay-title="Music" { spawn "dfr-launch-or-focus-tui" "kew"; }
    Mod+N              hotkey-overlay-title="Notes" { spawn "noctalia" "msg" "panel-toggle" "noctalia/notes:panel"; }
    Mod+K              hotkey-overlay-title="Calculator" repeat=false { spawn "noctalia" "msg" "panel-toggle" "samuelskovbakke/calculator-plus:panel"; }
    Ctrl+Shift+Escape  hotkey-overlay-title="System health" repeat=false { spawn "dfr-launch-or-focus-tui" "monitor"; }

    // #"Tools"
    Mod+P             hotkey-overlay-title="Pick window" { spawn "kitty" "--single-instance" "--class=dfr.floating.kitty" "sh" "-c" "printf 'Pick a window...\n\n'; niri msg pick-window; niri msg action focus-window-previous; printf '\nDone! Press CTRL+c to quit\n'; read"; }
    Mod+Semicolon     hotkey-overlay-title="Compose key cheatsheet" repeat=false { spawn "compose-picker"; }
    Mod+I             hotkey-overlay-title="Generate QR code" { spawn "noctalia" "msg" "panel-toggle" "abuamar142/qr-share:panel"; }
    Mod+Alt+P         hotkey-overlay-title="Crashes panel" { spawn "noctalia" "msg" "panel-toggle" "umedbazarov/crashes:panel"; }
    // Mod+Shift+P       hotkey-overlay-title="Pick color" { spawn-sh "killall hyprpicker || hyprpicker --autocopy --lowercase-hex"; }
    Alt+Q             hotkey-overlay-title="Ask Google AI" repeat=false { spawn "bash" "-c" "sentinel='🔍'; query=$(printf '%s\n' \"$sentinel\" | noctalia dmenu -p 'Ask Google AI'); if [ -z \"$query\" ] || [ \"$query\" = \"$sentinel\" ]; then exit 0; fi; encoded=$(jq -rn --arg q \"$query\" '$q|@uri'); niri msg action spawn -- xdg-open \"https://www.google.com/search?q=${encoded}&udm=50\""; }
    Ctrl+Grave        hotkey-overlay-title="AI Prompt Bridge: text edit" { spawn "AIPromptBridge" "--trigger" "textedit"; }
    Ctrl+Shift+Grave  hotkey-overlay-title="AI Prompt Bridge: text edit (clipboard)" { spawn "AIPromptBridge" "--trigger" "textedit-clipboard"; }
    Ctrl+Alt+X        hotkey-overlay-title="AI Prompt Bridge: snip" { spawn "AIPromptBridge" "--trigger" "snip"; }
    Ctrl+Alt+A        hotkey-overlay-title="AI Prompt Bridge: audio" { spawn "AIPromptBridge" "--trigger" "audio"; }
    Ctrl+Alt+T        hotkey-overlay-title="AI Prompt Bridge: text to speech" { spawn "AIPromptBridge" "--trigger" "tts"; }

    // #"Screenshots & Capture"
    // Mod+S             hotkey-overlay-title="Screenshot (region)" { spawn "dfr-screenshot" "region"; }
    // Mod+Shift+S       hotkey-overlay-title="Screenshot (window)" { spawn "dfr-screenshot" "window"; }
    // Mod+Ctrl+S        hotkey-overlay-title="Screenshot (monitor: focused)" { spawn "dfr-screenshot" "monitor-focused"; }
    // Mod+Ctrl+Shift+S  hotkey-overlay-title="Screenshot (monitor: all)" { spawn "dfr-screenshot" "monitor-all"; }
    Print             hotkey-overlay-title="Screenshot (region)" { spawn "noctalia" "msg" "screenshot-region"; }
    Ctrl+Shift+Print  hotkey-overlay-title="Screenshot (screen)" { spawn "noctalia" "msg" "screenshot-fullscreen"; }
    Shift+Print       hotkey-overlay-title="Screenshot (window)" { screenshot-window; }
    Ctrl+Print        hotkey-overlay-title="Screenshot and annotate" { spawn "tensaku" "--capture"; }
    Alt+Print         hotkey-overlay-title="Screenshot toolkit menu" { spawn "noctalia" "msg" "plugin" "alexander/screen-toolkit:service" "all" "toggle"; }
    Mod+O             hotkey-overlay-title="Annotation tool" { spawn "wayscriber" "--active"; }
    Mod+Y             hotkey-overlay-title="Cast focused window" { spawn-sh "niri msg action set-dynamic-cast-window --id $(niri msg --json focused-window | jq .id)"; }
    Mod+Alt+Y         hotkey-overlay-title="Mirror focused monitor to a window" repeat=false { spawn-sh "wl-mirror $(niri msg --json focused-output | jq -r .name)"; }
    Mod+U             hotkey-overlay-title="Pin to screen (frozen)" { spawn "pin-to-screen" "--noctalia"; }
    Mod+Alt+U         hotkey-overlay-title="Select region to float / pin to screen" { spawn "pin-to-screen"; }

    // #"Media & Hardware"
    XF86HangupPhone         hotkey-overlay-title="Previous track" allow-when-locked=true { spawn "noctalia" "msg" "media" "previous"; }
    XF86PickupPhone         hotkey-overlay-title="Play / pause track" allow-when-locked=true { spawn "noctalia" "msg" "media" "toggle"; }
    XF86Favorites           hotkey-overlay-title="Next track" allow-when-locked=true { spawn "noctalia" "msg" "media" "next"; }
    // XF86AudioPlay           allow-when-locked=true hotkey-overlay-title="Play / pause track" { spawn "playerctl" "play-pause"; }
    // XF86AudioStop           allow-when-locked=true hotkey-overlay-title="Stop track" { spawn "playerctl" "stop"; }
    // XF86AudioPrev           allow-when-locked=true hotkey-overlay-title="Previous track" { spawn "playerctl" "previous"; }
    // XF86AudioNext           allow-when-locked=true hotkey-overlay-title="Next track" { spawn "playerctl" "next"; }
    Mod+Left                hotkey-overlay-title="Seek -5 seconds" allow-when-locked=true { spawn "playerctl" "position" "5-"; }
    Mod+Right               hotkey-overlay-title="Seek +5 seconds" allow-when-locked=true { spawn "playerctl" "position" "5+"; }
    XF86AudioRaiseVolume    hotkey-overlay-title="Volume up" { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume    hotkey-overlay-title="Volume down" { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute           hotkey-overlay-title="Volume mute" { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute        hotkey-overlay-title="Mic mute" { spawn "noctalia" "msg" "mic-mute"; }
    // XF86AudioRaiseVolume    allow-when-locked=true hotkey-overlay-title="Raise volume" { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05+"; }
    // XF86AudioLowerVolume    allow-when-locked=true hotkey-overlay-title="Lower volume" { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05-"; }
    // XF86AudioMute           allow-when-locked=true hotkey-overlay-title="Mute playback" { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    // XF86AudioMicMute        allow-when-locked=true hotkey-overlay-title="Mute microphone"{ spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp     hotkey-overlay-title="Brightness up" { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown   hotkey-overlay-title="Brightness down" { spawn "noctalia" "msg" "brightness-down"; }
    // XF86MonBrightnessUp     allow-when-locked=true hotkey-overlay-title="Increase brightness" { spawn "brightnessctl" "--class=backlight" "set" "+5%"; }
    // XF86MonBrightnessDown   allow-when-locked=true hotkey-overlay-title="Decrease brightness" { spawn "brightnessctl" "--class=backlight" "set" "5%-"; }
    XF86NotificationCenter  hotkey-overlay-title="Toggle touchpad" repeat=false { spawn "toggle-niri-touchpad" "toggle"; }
    XF86Display             hotkey-overlay-title="Display settings" repeat=false { spawn "noctalia" "msg" "settings-toggle" "monitor"; }

    // #"Wallpaper"
    Mod+BackSlash             hotkey-overlay-title="Next wallpaper (rotate mode)" repeat=false cooldown-ms=300 { spawn "wallchemy" "rotate"; }
    Mod+Shift+BackSlash       hotkey-overlay-title="Restore previous wallpaper" repeat=false cooldown-ms=200 { spawn "wallchemy" "previous"; }
    Mod+Ctrl+BackSlash        hotkey-overlay-title="Save current wallpaper as favorite" repeat=false { spawn "wallchemy" "favorite"; }
    Mod+Ctrl+Shift+BackSlash  hotkey-overlay-title="Browse favorite wallpapers" repeat=false { spawn "wallchemy" "favorites"; }
    Mod+Alt+BackSlash         hotkey-overlay-title="Hot wallpaper" repeat=false cooldown-ms=500 { spawn "wallchemy" "hot"; }
    Mod+Alt+Shift+BackSlash   hotkey-overlay-title="Top wallpaper" repeat=false cooldown-ms=500 { spawn "wallchemy" "top"; }
    Mod+Ctrl+Alt+BackSlash    hotkey-overlay-title="Open current wallpaper on Wallhaven" repeat=false { spawn "wallchemy" "open"; }

    // #"System"
    Mod+L             hotkey-overlay-title="Lock screen" { spawn "noctalia" "msg" "session" "lock"; }
    Mod+Alt+L         hotkey-overlay-title="Power off monitors" { power-off-monitors; }
    Mod+Ctrl+Shift+Q  hotkey-overlay-title="Exit niri session" { spawn "uwsm" "stop"; }
    // Apps such as remote-desktop clients and software KVM switches may request
    // that niri stops processing the keyboard shortcuts defined here so they
    // may, for example, forward the key presses as-is to a remote machine.
    // It's a good idea to bind an escape hatch to toggle the inhibitor, so a
    // buggy application can't hold your session hostage.
    //
    // allow-inhibiting=false can be applied to other binds as well, which
    // ensures niri always processes them, even when an inhibitor is active.
    Mod+Escape        hotkey-overlay-title="Toggle shortcuts inhibitor (escape hatch)" allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+F12           hotkey-overlay-title="High-performance gaming and rendering profile" { spawn-sh "noctalia msg plugin 'detluck/performance-plus:service' all toggle"; }

    // #"Windows"
    Mod+X        hotkey-overlay-title="Close window" repeat=false { close-window; }
    Mod+Z        hotkey-overlay-title="Toggle floating window" repeat=false { toggle-window-floating; }
    Mod+T        hotkey-overlay-title="Switch focus between floating and tiling" { switch-focus-between-floating-and-tiling; }
    Mod+Alt+T    hotkey-overlay-title="Toggle tabbed column" { toggle-column-tabbed-display; }
    Mod+F        hotkey-overlay-title="Maximize column" { maximize-column; }
    Mod+Alt+F    hotkey-overlay-title="Full screen window" { fullscreen-window; }
    Mod+Shift+F  hotkey-overlay-title="Windowed (fake/detached) fullscreen" { toggle-windowed-fullscreen; }
    // Mod+Ctrl+F   hotkey-overlay-title="Fill empty column space" { expand-column-to-available-width; }
    Mod+Alt+O    hotkey-overlay-title="Toggle focused window glass/readability" repeat=false { toggle-window-rule-opacity; }
    Mod+Shift+O  hotkey-overlay-title="Toggle all window glass styling" repeat=false { spawn "toggle-niri-glass"; }
    Mod+Shift+G  hotkey-overlay-title="Toggle zero gaps and borders (flush layout)" repeat=false { spawn "toggle-niri-gaps"; }

    // #"Layout"
    Mod+C             hotkey-overlay-title="Center column" { center-column; }
    Mod+Alt+C         hotkey-overlay-title="Center all visible columns" { center-visible-columns; }
    Mod+BracketLeft   hotkey-overlay-title="Consume / expel window to the left" { consume-or-expel-window-left; }
    Mod+BracketRight  hotkey-overlay-title="Consume / expel window to the right" { consume-or-expel-window-right; }
    Mod+Comma         hotkey-overlay-title="Consume window into column" { consume-window-into-column; }
    Mod+Period        hotkey-overlay-title="Expel window from column" { expel-window-from-column; }
    Mod+R             hotkey-overlay-title="Cycle preset widths" { switch-preset-column-width; }
    Mod+Alt+R         hotkey-overlay-title="Cycle preset heights" { switch-preset-window-height; }
    Mod+Shift+R       hotkey-overlay-title="Reset window height" { reset-window-height; }
    Mod+Equal         hotkey-overlay-title="Increase column width" { set-column-width "+10%"; }
    Mod+Minus         hotkey-overlay-title="Decrease column width" { set-column-width "-10%"; }
    Mod+Alt+Equal     hotkey-overlay-title="Increase window height" { set-window-height "+10%"; }
    Mod+Alt+Minus     hotkey-overlay-title="Decrease window height" { set-window-height "-10%"; }

    // #"Focus"
    Mod+Slash  hotkey-overlay-title="Search keyboard shortcuts" { spawn "niri-keybinds"; }
    // Mod+O      repeat=false hotkey-overlay-title="Toggle overview (4-finger swipe)" { toggle-overview; }
    Mod+Tab    hotkey-overlay-title="Toggle overview (4-finger swipe)" repeat=false { toggle-overview; }
    // Mod+I      hotkey-overlay-title="Focus previously focused window" { focus-window-previous; } (use alt tab instead)
    // Mod+Left   hotkey-overlay-title="Focus column left" { focus-column-or-monitor-left; }
    // Mod+Down   hotkey-overlay-title="Focus column down" { focus-window-down; }
    // Mod+Up     hotkey-overlay-title="Focus column up" { focus-window-up; }
    // Mod+Right  hotkey-overlay-title="Focus column right" { focus-column-or-monitor-right; }
    Mod+A      hotkey-overlay-title="Focus column left (or monitor)" { focus-column-or-monitor-left; }
    Mod+D      hotkey-overlay-title="Focus column right (or monitor)" { focus-column-or-monitor-right; }
    Mod+W      hotkey-overlay-title="Focus window up (or workspace)" { focus-window-or-workspace-up; }
    Mod+S      hotkey-overlay-title="Focus window down (or workspace)" { focus-window-or-workspace-down; }
    Mod+Q      hotkey-overlay-title="Focus first column" { focus-column-first; }
    Mod+E      hotkey-overlay-title="Focus last column" { focus-column-last; }
    // Mod+Home   hotkey-overlay-title="Focus first column" { focus-column-first; }
    // Mod+End    hotkey-overlay-title="Focus last column" { focus-column-last; }

    // #"Move"
    // Mod+Alt+Left   hotkey-overlay-title="Move column left" { move-column-left; }
    // Mod+Alt+Down   hotkey-overlay-title="Move column down" { move-window-down; }
    // Mod+Alt+Up     hotkey-overlay-title="Move column up" { move-window-up; }
    // Mod+Alt+Right  hotkey-overlay-title="Move column right" { move-column-right; }
    Mod+Alt+A      hotkey-overlay-title="Move column left (or to monitor)" { move-column-left-or-to-monitor-left; }
    Mod+Alt+D      hotkey-overlay-title="Move column right (or to monitor)" { move-column-right-or-to-monitor-right; }
    Mod+Alt+W      hotkey-overlay-title="Move window up (or to workspace)" { move-window-up-or-to-workspace-up; }
    Mod+Alt+S      hotkey-overlay-title="Move window down (or to workspace)" { move-window-down-or-to-workspace-down; }
    Mod+Alt+Q      hotkey-overlay-title="Move column to first" { move-column-to-first; }
    Mod+Alt+E      hotkey-overlay-title="Move column to last" { move-column-to-last; }
    // Mod+Alt+Home   hotkey-overlay-title="Move column to first" { move-column-to-first; }
    // Mod+Alt+End    hotkey-overlay-title="Move column to last" { move-column-to-last; }

    // #"Scroll Wheel"
    Mod+WheelScrollDown            hotkey-overlay-title="Focus column right" { focus-column-or-monitor-right; }
    Mod+WheelScrollUp              hotkey-overlay-title="Focus column left" { focus-column-or-monitor-left; }
    Mod+WheelScrollRight           hotkey-overlay-title="Focus column right" { focus-column-or-monitor-right; }
    Mod+WheelScrollLeft            hotkey-overlay-title="Focus column left" { focus-column-or-monitor-left; }
    Mod+Alt+WheelScrollDown        hotkey-overlay-title="Move column right" { move-column-right; }
    Mod+Alt+WheelScrollUp          hotkey-overlay-title="Move column left" { move-column-left; }
    Mod+Alt+WheelScrollRight       hotkey-overlay-title="Move column right" { move-column-right; }
    Mod+Alt+WheelScrollLeft        hotkey-overlay-title="Move column left" { move-column-left; }
    Mod+Shift+WheelScrollDown      hotkey-overlay-title="Focus next workspace" cooldown-ms=150 { focus-workspace-down; }
    Mod+Shift+WheelScrollUp        hotkey-overlay-title="Focus previous workspace" cooldown-ms=150 { focus-workspace-up; }
    Mod+Shift+Alt+WheelScrollDown  hotkey-overlay-title="Move column to next workspace" cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Shift+Alt+WheelScrollUp    hotkey-overlay-title="Move column to previous workspace" cooldown-ms=150 { move-column-to-workspace-up; }

    // #"Monitors"
    Mod+Ctrl+A             hotkey-overlay-title="Focus left monitor" { focus-monitor-left; }
    Mod+Ctrl+S             hotkey-overlay-title="Focus lower monitor" { focus-monitor-down; }
    Mod+Ctrl+W             hotkey-overlay-title="Focus upper monitor" { focus-monitor-up; }
    Mod+Ctrl+D             hotkey-overlay-title="Focus right monitor" { focus-monitor-right; }
    // Mod+Ctrl+Left          { focus-monitor-left; }
    // Mod+Ctrl+Down          { focus-monitor-down; }
    // Mod+Ctrl+Up            { focus-monitor-up; }
    // Mod+Ctrl+Right         { focus-monitor-right; }
    Mod+Ctrl+Alt+A         hotkey-overlay-title="Move column to left monitor" { move-column-to-monitor-left; }
    Mod+Ctrl+Alt+S         hotkey-overlay-title="Move column to lower monitor" { move-column-to-monitor-down; }
    Mod+Ctrl+Alt+W         hotkey-overlay-title="Move column to upper monitor" { move-column-to-monitor-up; }
    Mod+Ctrl+Alt+D         hotkey-overlay-title="Move column to right monitor" { move-column-to-monitor-right; }
    // Mod+Ctrl+Shift+Left    hotkey-overlay-title="Move column to left monitor" { move-column-to-monitor-left; }
    // Mod+Ctrl+Shift+Down    hotkey-overlay-title="Move column to lower monitor" { move-column-to-monitor-down; }
    // Mod+Ctrl+Shift+Up      hotkey-overlay-title="Move column to upper monitor" { move-column-to-monitor-up; }
    // Mod+Ctrl+Shift+Right   hotkey-overlay-title="Move column to right monitor" { move-column-to-monitor-right; }
    Mod+Shift+Equal        hotkey-overlay-title="Increase focused monitor scale" { spawn "output-scale" "+"; }
    Mod+Shift+Minus        hotkey-overlay-title="Decrease focused monitor scale" { spawn "output-scale" "-"; }
    // Mod+Shift+0            hotkey-overlay-title="Reset focused monitor scale" { spawn "output-scale" "1.0"; }
    Mod+Ctrl+M             hotkey-overlay-title="Toggle output mouse hard lock" { spawn "output-toggle-mouse-lock"; }
    Mod+Ctrl+Shift+M       hotkey-overlay-title="Toggle output mouse soft lock" { spawn "output-toggle-mouse-lock" "--soft"; }
    // Mod+MouseBack          hotkey-overlay-title="Focus left monitor" { focus-monitor-left; }
    // Mod+MouseForward       hotkey-overlay-title="Focus right monitor" { focus-monitor-right; }
    // Mod+Ctrl+MouseBack     hotkey-overlay-title="Move column to left monitor" { move-column-to-monitor-left; }
    // Mod+Ctrl+MouseForward  hotkey-overlay-title="Move column to right monitor" { move-column-to-monitor-right; }

    // #"Workspaces"
    Mod+Shift+S          hotkey-overlay-title="Focus next workspace" { focus-workspace-down; }
    Mod+Shift+W          hotkey-overlay-title="Focus previous workspace" { focus-workspace-up; }
    Mod+Shift+Down       hotkey-overlay-title="Focus next workspace" { focus-workspace-down; }
    Mod+Shift+Up         hotkey-overlay-title="Focus previous workspace" { focus-workspace-up; }
    Mod+Page_Down        hotkey-overlay-title="Focus next workspace" { focus-workspace-down; }
    Mod+Page_Up          hotkey-overlay-title="Focus previous workspace" { focus-workspace-up; }
    Mod+Shift+Alt+S      hotkey-overlay-title="Move column to next workspace" { move-column-to-workspace-down; }
    Mod+Shift+Alt+W      hotkey-overlay-title="Move column to previous workspace" { move-column-to-workspace-up; }
    Mod+Shift+Alt+Down   hotkey-overlay-title="Move column to next workspace" { move-column-to-workspace-down; }
    Mod+Shift+Alt+Up     hotkey-overlay-title="Move column to previous workspace" { move-column-to-workspace-up; }
    Mod+Alt+Page_Down    hotkey-overlay-title="Move column to next workspace" { move-column-to-workspace-down; }
    Mod+Alt+Page_Up      hotkey-overlay-title="Move column to previous workspace" { move-column-to-workspace-up; }
    Mod+Shift+Page_Down  hotkey-overlay-title="Move workspace down" { move-workspace-down; }
    Mod+Shift+Page_Up    hotkey-overlay-title="Move workspace up" { move-workspace-up; }
    Mod+Ctrl+Page_Down   hotkey-overlay-title="Move workspace to previous monitor" { move-workspace-to-monitor-previous; }
    Mod+Ctrl+Page_Up     hotkey-overlay-title="Move workspace to next monitor" { move-workspace-to-monitor-next; }

    // #"Workspace Numbers"
    Mod+1       hotkey-overlay-title="Focus workspace 1" { focus-workspace 1; }
    Mod+2       hotkey-overlay-title="Focus workspace 2" { focus-workspace 2; }
    Mod+3       hotkey-overlay-title="Focus workspace 3" { focus-workspace 3; }
    Mod+4       hotkey-overlay-title="Focus workspace 4" { focus-workspace 4; }
    Mod+5       hotkey-overlay-title="Focus workspace 5" { focus-workspace 5; }
    Mod+6       hotkey-overlay-title="Focus workspace 6" { focus-workspace 6; }
    Mod+7       hotkey-overlay-title="Focus workspace 7" { focus-workspace 7; }
    Mod+8       hotkey-overlay-title="Focus workspace 8" { focus-workspace 8; }
    Mod+9       hotkey-overlay-title="Focus workspace 9" { focus-workspace 9; }
    // Mod+Ctrl+1  hotkey-overlay-title="Move window to workspace (1-9)" { move-window-to-workspace 1; }
    // Mod+Ctrl+2  { move-window-to-workspace 2; }
    // Mod+Ctrl+3  { move-window-to-workspace 3; }
    // Mod+Ctrl+4  { move-window-to-workspace 4; }
    // Mod+Ctrl+5  { move-window-to-workspace 5; }
    // Mod+Ctrl+6  { move-window-to-workspace 6; }
    // Mod+Ctrl+7  { move-window-to-workspace 7; }
    // Mod+Ctrl+8  { move-window-to-workspace 8; }
    // Mod+Ctrl+9  { move-window-to-workspace 9; }
    Mod+Alt+1   hotkey-overlay-title="Move column to workspace 1" { move-column-to-workspace 1; }
    Mod+Alt+2   hotkey-overlay-title="Move column to workspace 2" { move-column-to-workspace 2; }
    Mod+Alt+3   hotkey-overlay-title="Move column to workspace 3" { move-column-to-workspace 3; }
    Mod+Alt+4   hotkey-overlay-title="Move column to workspace 4" { move-column-to-workspace 4; }
    Mod+Alt+5   hotkey-overlay-title="Move column to workspace 5" { move-column-to-workspace 5; }
    Mod+Alt+6   hotkey-overlay-title="Move column to workspace 6" { move-column-to-workspace 6; }
    Mod+Alt+7   hotkey-overlay-title="Move column to workspace 7" { move-column-to-workspace 7; }
    Mod+Alt+8   hotkey-overlay-title="Move column to workspace 8" { move-column-to-workspace 8; }
    Mod+Alt+9   hotkey-overlay-title="Move column to workspace 9" { move-column-to-workspace 9; }
}

// ----------------------------------------------------------------------------
// Includes
// ----------------------------------------------------------------------------

// Noctalia theme. Keep last so it overrides anything above.
// include optional=true "config.kdl.local"
include "noctalia.kdl"
